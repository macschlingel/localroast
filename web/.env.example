DATABASE_URL=postgresql://user:password@localhost:5432/localroast
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
NEXTAUTH_URL=http://localhost:3000

# Optional OAuth providers. Providers without both values are disabled.
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development-only credentials provider. It is never registered in production.
DEV_LOGIN_EMAIL=dev@example.com
DEV_LOGIN_PASSWORD=change-me-locally
